{
	"name": "pogranicze-galaktyki",
	"version": "0.171.17",
	"private": true,
	"description": "Samodzielny prototyp kosmicznego RTS",
	"author": "Marcin Murawski",
	"main": "electron/main.js",
	"scripts": {
		"start": "node server.js",
		"lobby": "node lobby-server.js",
		"test": "node --test \"tests/*.test.js\"",
		"build:3d": "node tools/build-3d.js",
		"icon": "node tools/make-icon.js",
		"app": "electron .",
		"app:check": "node tools/app-check.js",
		"dist": "node tools/dist.js",
		"dist:dir": "node tools/dist.js --dir"
	},
	"devDependencies": {
		"electron": "^44.7.0",
		"electron-builder": "^26.15.3"
	},
	"build": {
		"appId": "pl.pogranicze.galaktyki",
		"productName": "Pogranicze Galaktyki",
		"copyright": "© 2026 Marcin Murawski",
		"directories": {
			"output": "dist",
			"buildResources": "build"
		},
		"files": [
			"**/*",
			"!tests/**",
			"!tools/**",
			"!docs/**",
			"!dist/**",
			"!build/**",
			"!**/*.md",
			"!prototyp-*.html",
			"!server.js",
			"!webgl/prototype.js",
			"!webgl3d/prototype-3d.js",
			"!assets/models/*.blend*",
			"!**/*.py",
			"!**/*.cmd",
			"!.claude/**"
		],
		"asar": true,
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				},
				{
					"target": "portable",
					"arch": [
						"x64"
					]
				}
			],
			"icon": "build/icon.png"
		},
		"nsis": {
			"oneClick": false,
			"perMachine": false,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"shortcutName": "Pogranicze Galaktyki",
			"artifactName": "Pogranicze-Galaktyki-${version}-instalator.${ext}"
		},
		"portable": {
			"artifactName": "Pogranicze-Galaktyki-${version}-przenosna.${ext}"
		}
	}
}
